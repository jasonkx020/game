{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "auth-api",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/auth-service/cmd/auth-api",
      "cwd": "${workspaceFolder}/auth-service",
      "envFile": "${workspaceFolder}/server/.env"
    },
    {
      "name": "game-api",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/server/cmd/game-api",
      "cwd": "${workspaceFolder}/server",
      "envFile": "${workspaceFolder}/server/.env"
    },
    {
      "name": "game",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/server/cmd/game",
      "cwd": "${workspaceFolder}/server",
      "envFile": "${workspaceFolder}/server/.env"
    },
    {
      "name": "admin-api",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/admin/cmd/admin-api",
      "cwd": "${workspaceFolder}/admin",
      "envFile": "${workspaceFolder}/.env"
    }
  ],
  "compounds": [
    {
      "name": "Server (auth + game-api + game)",
      "configurations": ["auth-api", "game-api", "game"],
      "stopAll": true
    },
    {
      "name": "Server (game-api + game)",
      "configurations": ["game-api", "game"],
      "stopAll": true
    },
    {
      "name": "Admin (admin-api)",
      "configurations": ["admin-api"],
      "stopAll": true
    }
  ]
}
