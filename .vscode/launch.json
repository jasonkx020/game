{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "auth-api",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/auth-service/cmd/auth-api",
      "cwd": "${workspaceFolder}/auth-service",
      "envFile": "${workspaceFolder}/server/.env"
    },
    {
      "name": "platform-api",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/server/cmd/platform-api",
      "cwd": "${workspaceFolder}/server",
      "envFile": "${workspaceFolder}/server/.env"
    },
    {
      "name": "game",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/server/cmd/game",
      "cwd": "${workspaceFolder}/server",
      "envFile": "${workspaceFolder}/server/.env"
    }
  ],
  "compounds": [
    {
      "name": "Server (auth + api + game)",
      "configurations": ["auth-api", "platform-api", "game"],
      "stopAll": true
    },
    {
      "name": "Server (api + game)",
      "configurations": ["platform-api", "game"],
      "stopAll": true
    }
  ]
}
