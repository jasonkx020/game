DATABASE_URL=postgres://game:game@localhost:5432/game?sslmode=disable
REDIS_URL=redis://localhost:6379/0
HMAC_SECRET=dev-hmac-secret-change-me
APP_ID=cocos-dev
DEV_SMS_CODE=123456
DEV_EMAIL_CODE=123456
AUTH_HTTP_PORT=8081
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=90
# 轮换后旧 refresh 仍可换票的秒数（防客户端未落盘新 token）
REFRESH_GRACE_SECONDS=120
CORS_ORIGINS=http://localhost:5173,http://localhost:7456,http://127.0.0.1:7456
GIN_MODE=debug
ADMIN_DEV_PHONE=13800000000

# Access JWT: ES256（Auth 持私钥；业务服只配公钥）
JWT_KEY_ID=es256-1
JWT_PRIVATE_KEY_FILE=keys/jwt-es256-dev.pem
JWT_PUBLIC_KEY_FILE=keys/jwt-es256-dev.pub.pem
# 或内联 PEM（\n 转义）：JWT_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...

# WeChat: mock | live
WECHAT_MODE=mock
WECHAT_MP_APP_ID=
WECHAT_MP_SECRET=
WECHAT_WEB_APP_ID=
WECHAT_WEB_SECRET=

# KYC: mock | live (Aliyun Id2MetaVerify)
KYC_MODE=mock
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_CLOUDAUTH_ENDPOINT=cloudauth.aliyuncs.com
