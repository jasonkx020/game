# Prefer deploy/postgresql/config.ini + init-db.
# This file is only a reminder of env names used after bootstrap.
#
# Windows:  cd deploy\postgresql && init-db.bat
# Linux:    cd deploy/postgresql && ./init-db.sh
# Wrapper:  .\scripts\dev.ps1 init-db   /   make init-db
#
# Generated credentials: deploy/postgresql/postgres.env (gitignored)

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_USER=game
POSTGRES_PASSWORD=
POSTGRES_DB=game
POSTGRES_DB_AUTH=
DATABASE_URL=postgres://game:CHANGE_ME@127.0.0.1:5432/game?sslmode=disable
