DATABASE_URL=postgres://game:game@localhost:5432/game?sslmode=disable
# 可选：迁移专用连接（默认与 DATABASE_URL 相同；仅 dev.ps1 migrate-docker 需要 host.docker.internal）
# MIGRATE_DATABASE_URL=postgres://game:game@host.docker.internal:5432/game?sslmode=disable
REDIS_URL=redis://localhost:6379/0
HMAC_SECRET=tC3pMVXbxyVjKIbUonaOSRrUwI2E0axmvqg4Xb/0F64=
APP_ID=cocos-dev
DEV_SMS_CODE=123456
# Access JWT：仅公钥验 ES256（私钥只在 auth-service）
JWT_PUBLIC_KEY_FILE=keys/jwt-es256-dev.pub.pem
# HTTP/WS 监听地址（仅 game-api / admin-api / game；默认全网卡）
HTTP_LISTEN_HOST=0.0.0.0
GAME_API_HTTP_PORT=8080
# 运营 admin-api（独立进程；停服不影响玩家路径）
ADMIN_HTTP_PORT=8082
# 登录/刷新由 auth-service 提供
AUTH_HTTP_PORT=8081
AUTH_BASE_URL=http://localhost:8081
PITAYA_WS_PORT=3250
PITAYA_WS_URL=ws://localhost:3250
# Connector 发现（ADR-009）：game 写 Redis；game-api GET /v1/discovery/assign
DISCOVERY_ENABLED=true
# CONNECTOR_INSTANCE_ID=game-localhost-3250
# CONNECTOR_WS_DIRECT_URL=ws://localhost:3250
# WS_GATEWAY_URL=ws://localhost:3250
# HTTP_GATEWAY_URL=http://localhost:8090
SNOWFLAKE_WORKER_ID=1
GIN_MODE=debug
CORS_ORIGINS=http://localhost:8082,http://localhost:5173,http://localhost:7456,http://127.0.0.1:7456,http://localhost:7457,http://127.0.0.1:7457
ADMIN_DEV_PHONE=13800000000

# Companion LLM（OpenAI 兼容；留空则使用本地启发式回复 + Tool）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SEC=60

# 风控：GPS 默认仅告警；异常输赢默认不自动冻结
RISK_GPS_HARD_BLOCK=false
RISK_AUTO_FREEZE=false